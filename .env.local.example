# Turso Database
TURSO_DATABASE_URL=libsql://your-database.turso.co
TURSO_AUTH_TOKEN=your-turso-auth-token

# Auth JWT Secret (used for signing session tokens)
AUTH_JWT_SECRET=your-jwt-secret-here

# Cloudflare R2 Storage
R2_ENDPOINT=https://your-account.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=your-access-key
R2_SECRET_ACCESS_KEY=your-secret-key
R2_BUCKET=your-bucket-name
VITE_R2_PUBLIC_URL=https://your-bucket.r2.dev
VITE_R2_BUCKET_NAME=your-bucket-name

# Web Push VAPID keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VITE_VAPID_PUBLIC_KEY=
GROQ_API_KEY=
MODEL=qwen/qwen3-32b
